<header class="ks-header">
  <div class="ks-brand">
    <div class="ks-logo">P</div>
    <div>
      <div class="ks-brand-name">PackPoint</div>
      <div class="ks-brand-sub">Shipping Station · STN-01</div>
    </div>
  </div>

  <div class="ks-header-right">
    <% if ENV['APP_ENV']=='development' %>
      <div class="ks-dev-badge">Development</div>
      <% end %>

        <div class="ks-printer-pill <%= printer_available ? '' : 'ks-pill-error' %>">
          <span class="ks-dot"></span>
          <span>
            <% if printer_available %>
              PM-241-BT Ready
              <% elsif printer_error %>
                PM-241-BT Error: <%= printer_error %>
                  <% else %>
                    PM-241-BT Not Available
                    <% end %>
          </span>
        </div>

        <div class="ks-theme-toggle">
          <button type="button" class="ks-theme-btn" data-theme-choice="light">Light</button>
          <button type="button" class="ks-theme-btn" data-theme-choice="dark">Dark</button>
        </div>
  </div>
</header>

<% if stripe_warnings&.any? %>
  <div class="ks-warning-banner">
    <% stripe_warnings.each do |warning| %>
      <div class="ks-warning-row">⚠️ <%= warning %></div>
      <% end %>
  </div>
  <% end %>

<% aging_count=orders.count { |order| order_aging?(order.date) } %>
  <div class="ks-subbar">
    <div class="ks-store-tabs">
      <% stores.each do |store| %>
        <div class="ks-tab">
          <span class="ks-tab-dot"></span>
          <span><%= store[:name] %></span>
          <span class="ks-tab-count">
            <%= store[:count] %>
          </span>
        </div>
        <% end %>
    </div>

    <div class="ks-subbar-right">
      <div class="ks-stat">
        <span class="ks-stat-num">
          <%= orders.count { |order| !order.shipped } %>
        </span>
        <span class="ks-stat-label">unshipped</span>
      </div>
      <div class="ks-aging <%= 'ks-aging-active' if aging_count > 0 %>">
        <span class="ks-aging-num">
          <%= aging_count %>
        </span> aging &gt; 48h
      </div>
      <button type="button" class="ks-btn-outline" id="archive-toggle">Archive ▸</button>
    </div>
  </div>

  <div id="archive-section" style="display:none;">
    <div class="ks-archive-header">
      <span>Shipped in the last <%= archive_days %> days</span>
      <button type="button" class="ks-btn-ghost" id="archive-refresh" style="display:none;">Refresh</button>
    </div>
    <div id="archive-content"></div>
  </div>

  <div class="ks-table">
    <div class="ks-col-header">
      <div></div>
      <div>Product</div>
      <div>Store</div>
      <div>Order</div>
      <div>Age</div>
      <div>Recipient</div>
      <div>Destination</div>
      <div class="ks-col-right">Label</div>
    </div>

    <% orders.sort_by { |order| order.date.to_time }.each do |order| %>
      <% status = order_status(order); label = purchased_labels[order.order_number.to_s]; total_qty = order.products.sum(&:qty); total_price = order.products.sum { |p| p.price.to_f }; is_openspool = order.products.any? { |p| p.name.to_s.downcase.include?('openspool') } %>
        <div class="ks-row-wrap">
          <div class="ks-row" data-target="details-<%= order.order_number %>">
            <div class="ks-chevron">▸</div>
            <div>
              <div class="ks-product-name">
                <%= order.products.map(&:name).join(", ") %></div>
          <div class=" ks-product-sub">
                  <%= total_qty %>
                    <%= total_qty==1 ? 'item' : 'items' %> · $<%= '%.2f' % total_price %>
              </div>
            </div>
            <div>
              <span class="ks-store-badge"><span class="ks-store-dot"></span><%= order.store_display_name %></span>
            </div>
            <div class="ks-order-no" title="<%= order.order_number %>">
              <%= display_order_number(order) %>
            </div>
            <div class="ks-age <%= 'ks-age-hot' if order_aging?(order.date) %>">
              <%= order_age(order.date) %>
            </div>
            <div class="ks-recipient">
              <%= order.address_dict[:recipient_name] %>
            </div>
            <div class="ks-destination">
              <span class="ks-flag">
                <%= countries[order.address_dict[:country_code]] %>
              </span>
              <span>
                <%= order.address_dict[:country] %>
              </span>
            </div>
            <div class="ks-label-col">
              <span class="ks-status-pill ks-status-<%= status %>">
                <% if status=='need' %>
                  Needs label
                  <% elsif status=='ready' %>
                    Label ready
                    <% else %>
                      International
                      <% end %>
              </span>
            </div>
          </div>

          <div class="ks-detail" id="details-<%= order.order_number %>" style="display:none;">
            <div class="ks-detail-grid">
              <div class="ks-detail-box">
                <div class="ks-detail-box-head">
                  <div class="ks-detail-box-title">Items</div>
                  <div class="ks-detail-order-no" title="<%= order.order_number %>">
                    <%= display_order_number(order) %>
                  </div>
                </div>
                <% order.products.each do |item| %>
                  <div class="ks-item-row">
                    <span class="ks-qty-badge <%= 'ks-qty-badge-multi' if item.qty > 1 %>">&times;<%= item.qty %></span>
                    <div class="ks-item-info">
                      <div class="ks-item-name">
                        <%= item.name %>
                      </div>
                      <div class="ks-item-opt">
                        <%= item.options %>
                      </div>
                    </div>
                    <div class="ks-item-price">$<%= '%.2f' % item.price %>
                    </div>
                  </div>
                  <% end %>
                    <div class="ks-item-actions">
                      <% if order.store_type=='tindie' %>
                        <a class="ks-btn-outline" href="https://www.tindie.com/orders/print/<%= order.order_number %>"
                          onclick="window.open(this.href, '_blank'); return false;">Print Packing Slip</a>
                        <button type="button" class="ks-btn-ghost"
                          onclick="window.open('https://www.tindie.com/orders/print/<%= order.order_number %>/?api_key=<%= api_key %>&username=<%= username %>', '_blank')">View
                          Slip &rarr;</button>
                        <% else %>
                          <button type="button" class="ks-btn-ghost"
                            onclick="window.open('https://dashboard.stripe.com/payments/<%= order.payment_intent_id %>', '_blank')">View
                            in Stripe &rarr;</button>
                          <% end %>
                    </div>
              </div>

              <div class="ks-detail-box">
                <div class="ks-detail-box-head">
                  <div class="ks-detail-box-title">Ship To</div>
                  <% if order.store_type == 'stripe' %>
                    <div class="ks-kebab-wrap">
                      <button type="button" class="ks-kebab-btn" aria-label="More actions">&#8942;</button>
                      <div class="ks-kebab-menu" style="display:none;">
                        <button type="button" class="ks-kebab-item mark-shipped-toggle">Mark as Shipped&hellip;</button>
                      </div>
                      <!-- Label bought outside PackPoint (e.g. directly in EasyPost) - unlike the
                           post-buy confirm-shipped-form below, nothing here is known automatically,
                           so carrier/tracking/email are all typed in by hand. Otherwise the same
                           .confirm-shipped-form wiring (bindConfirmShippedForms) and /confirm_shipped
                           endpoint as everywhere else - see the class list below. -->
                      <form class="mark-shipped-form confirm-shipped-form" action="/confirm_shipped/<%= order.order_number %>"
                        method="post" style="display:none;">
                        <input type="hidden" name="store_key" value="<%= order.store_key %>">
                        <input type="hidden" name="payment_intent_id" value="<%= order.payment_intent_id %>">
                        <div class="ks-hint-box">Label bought outside PackPoint</div>
                        <div class="ks-tracking-box">
                          <span class="ks-tracking-label">CARRIER</span>
                          <select class="ks-tracking-code-input confirm-carrier-field" name="carrier" required>
                            <option value="" disabled selected>Select carrier</option>
                            <option value="usps">USPS</option>
                            <option value="fedex">FedEx</option>
                            <option value="ups">UPS</option>
                            <option value="dhl">DHL</option>
                          </select>
                        </div>
                        <div class="ks-tracking-box">
                          <span class="ks-tracking-label">TRK</span>
                          <input class="ks-tracking-code-input confirm-tracking-code-field" type="text"
                            name="tracking_code" required>
                        </div>
                        <div class="ks-tracking-box">
                          <span class="ks-tracking-label">EMAIL</span>
                          <input class="ks-tracking-code-input confirm-email-field" type="text" name="email"
                            value="<%= order.recipient_email %>" placeholder="customer@example.com">
                        </div>
                        <div class="confirm-shipped-status mark-shipped-status" style="display:none;"></div>
                        <div class="ks-buy-actions-row">
                          <button type="button" class="ks-btn-outline mark-shipped-cancel">Cancel</button>
                          <button type="submit" class="ks-btn-primary confirm-shipped-btn">Mark as Shipped</button>
                          <button type="button" class="ks-btn-outline confirm-shipped-info-btn">Info</button>
                        </div>
                        <pre class="confirm-shipped-preview" style="display:none;"></pre>
                      </form>
                    </div>
                    <% end %>
                </div>
                <div class="ks-ship-address">
                  <div class="ks-ship-name">
                    <%= order.address_dict[:recipient_name] %>
                  </div>
                  <div class="ks-ship-muted">
                    <%= order.address_dict[:street] %>
                  </div>
                  <div class="ks-ship-muted">
                    <%= order.address_dict[:city] %>, <%= order.address_dict[:state] %>
                        <%= order.address_dict[:postcode] %>
                  </div>
                  <div class="ks-ship-country">
                    <span class="ks-flag">
                      <%= countries[order.address_dict[:country_code]] %>
                    </span>
                    <span>
                      <%= order.address_dict[:country] %>
                    </span>
                  </div>
                </div>

                <div class="ks-ship-action">
                  <% if status=='ready' && label %>
                    <div class="ks-tracking-box">
                      <span class="ks-tracking-label">TRK</span>
                      <span class="ks-tracking-code">
                        <%= label[:tracking_code] %>
                      </span>
                    </div>
                    <div class="ks-ship-btn-row">
                      <button type="button" class="ks-btn-primary print-label-btn"
                        data-label-url="<%= label[:label_url] %>">Print Shipping Label</button>
                      <a class="ks-btn-outline label-link" href="<%= label[:label_url] %>" target="_blank">View</a>
                    </div>
                    <div class="ks-print-status" style="display:none;"></div>
                    <% if order.store_type == 'stripe' %>
                      <!-- The normal "mark as shipped" step - a label was just bought through
                           PackPoint (this session), so carrier/label_url/tracking_url are all
                           already known (see ShippingService#buy_shipment) and just need
                           confirming, not re-entering. Separate from the kebab-menu
                           "Mark as Shipped..." form above, which is for labels bought outside
                           PackPoint - same /confirm_shipped endpoint, just with carrier/tracking/
                           email typed in by hand instead of pre-filled. -->
                      <form class="confirm-shipped-form" action="/confirm_shipped/<%= order.order_number %>"
                        method="post">
                        <input type="hidden" name="store_key" value="<%= order.store_key %>">
                        <input type="hidden" name="payment_intent_id" value="<%= order.payment_intent_id %>">
                        <input type="hidden" name="carrier" class="confirm-carrier-field" value="<%= label[:carrier] %>">
                        <input type="hidden" name="label_url" class="confirm-label-url-field"
                          value="<%= label[:label_url] %>">
                        <input type="hidden" name="tracking_url" class="confirm-tracking-url-field"
                          value="<%= label[:tracking_url] %>">
                        <div class="ks-tracking-box">
                          <span class="ks-tracking-label">TRK</span>
                          <input class="ks-tracking-code-input confirm-tracking-code-field" type="text"
                            name="tracking_code" value="<%= label[:tracking_code] %>" required>
                        </div>
                        <!-- Editable + visible (unlike the other forms' hidden "email") so the
                             operator can redirect who gets notified before confirming shipment. -->
                        <div class="ks-tracking-box">
                          <span class="ks-tracking-label">EMAIL</span>
                          <input class="ks-tracking-code-input confirm-email-field" type="text" name="email"
                            value="<%= order.recipient_email %>" placeholder="customer@example.com">
                        </div>
                        <div class="ks-buy-actions-row">
                          <button type="submit" class="ks-btn-primary confirm-shipped-btn">Mark as Shipped</button>
                          <button type="button" class="ks-btn-outline confirm-shipped-info-btn">Info</button>
                        </div>
                        <div class="confirm-shipped-status mark-shipped-status" style="display:none;"></div>
                        <pre class="confirm-shipped-preview" style="display:none;"></pre>
                      </form>
                      <% end %>
                        <% elsif status=='intl' %>
                      <% customs_items = customs_items_for(order); customs_missing = customs_items.any? { |item| item[:missing] } %>
                        <div class="ks-verify-box" data-order-number="<%= order.order_number %>" data-pending="true">
                          <div class="ks-verify-status">Address not checked yet</div>
                        </div>

                        <% if customs_missing %>
                          <div class="ks-hint-box ks-hint-warn">⚠️ Missing HS code / origin country for one or more
                            items below - Tindie doesn't provide this, so it needs to be filled in by hand (or added to
                            <code>config/customs_catalog.yml</code> for next time).</div>
                          <% end %>

                            <form class="buy-label-form intl-label-form" action="/buy_label/<%= order.order_number %>"
                              method="post">
                              <input type="hidden" name="store_type" value="<%= order.store_type %>">
                              <input type="hidden" name="store_key" value="<%= order.store_key %>">
                              <input type="hidden" name="payment_intent_id"
                                value="<%= order.payment_intent_id if order.store_type == 'stripe' %>">
                              <input type="hidden" name="shipping_name" value="<%= order.address_dict[:recipient_name] %>">
                              <input type="hidden" name="shipping_street" value="<%= order.address_dict[:street] %>">
                              <input type="hidden" name="shipping_city" value="<%= order.address_dict[:city] %>">
                              <input type="hidden" name="shipping_state" value="<%= order.address_dict[:state] %>">
                              <input type="hidden" name="shipping_postcode" value="<%= order.address_dict[:postcode] %>">
                              <!-- Country as an ISO-3166 code, not the display name (unlike the domestic form) -
                                   EasyPost/carrier address matching for non-US countries is far less forgiving of
                                   "Deutschland" vs "Germany" vs "DE" than it is of the various ways to spell "United
                                   States", so the code is what actually gets sent. -->
                              <input type="hidden" name="shipping_country" value="<%= order.address_dict[:country_code] %>">
                              <input type="hidden" name="shipping_phone"
                                value="<%= order.recipient_phone unless order.recipient_phone.to_s.empty? %>">
                              <input type="hidden" name="email"
                                value="<%= order.recipient_email unless order.recipient_email.to_s.empty? %>">
                              <input type="hidden" name="shipment_id" value="">
                              <input type="hidden" name="carrier" value="usps">
                              <input type="hidden" name="customs_required" value="1">
                              <input type="hidden" name="customs_items" class="customs-items-field" value="">

                              <% if is_openspool %>
                                <div class="ks-hint-box">Openspool default box: 6&times;4&times;4 in, 5oz</div>
                                <% else %>
                                  <label class="ks-select-label">Box dimensions (in) &amp; weight</label>
                                  <div class="ks-dim-row">
                                    <input class="ks-input" type="number" step="0.1" min="0.1" name="parcel_length"
                                      placeholder="L" required>
                                    <input class="ks-input" type="number" step="0.1" min="0.1" name="parcel_width"
                                      placeholder="W" required>
                                    <input class="ks-input" type="number" step="0.1" min="0.1" name="parcel_height"
                                      placeholder="H" required>
                                    <div class="ks-weight-field">
                                      <input class="ks-input weight-input" type="number" step="0.1" min="0.1"
                                        placeholder="oz" required>
                                      <div class="ks-unit-toggle">
                                        <button type="button" class="ks-unit-btn ks-unit-btn-active"
                                          data-unit="oz">oz</button>
                                        <button type="button" class="ks-unit-btn" data-unit="g">g</button>
                                      </div>
                                      <input type="hidden" name="parcel_weight" class="weight-value">
                                    </div>
                                  </div>
                                  <% end %>

                                    <label class="ks-select-label">Customs items - value is the total for the line
                                      (qty &times; unit price), not per unit</label>
                                    <div class="ks-customs-items">
                                      <% customs_items.each do |item| %>
                                        <div class="ks-customs-row <%= 'ks-customs-row-missing' if item[:missing] %>">
                                          <input class="ks-input" type="text" data-field="description"
                                            value="<%= item[:description] %>" placeholder="Description" required>
                                          <input class="ks-input ks-input-narrow" type="text" data-field="hs_tariff_number"
                                            value="<%= item[:hs_tariff_number] %>" placeholder="HS code" required>
                                          <input class="ks-input ks-input-narrow" type="text" data-field="origin_country"
                                            value="<%= item[:origin_country] %>" placeholder="Origin" maxlength="2"
                                            required>
                                          <input class="ks-input ks-input-narrow" type="number" step="1" min="1"
                                            data-field="quantity" value="<%= item[:quantity] %>" placeholder="Qty"
                                            required>
                                          <input class="ks-input ks-input-narrow" type="number" step="0.01" min="0"
                                            data-field="value" value="<%= '%.2f' % item[:value] %>"
                                            placeholder="Total value" required>
                                        </div>
                                        <% end %>
                                    </div>

                                    <div class="ks-rate-box" style="display:none;"></div>
                                    <div class="ks-buy-actions-row">
                                      <button type="button" class="ks-btn-outline rate-check-btn">Check Price</button>
                                      <button type="submit" class="ks-btn-primary">Buy Shipping Label</button>
                                    </div>
                            </form>
                            <div class="ks-form-error" style="display:none;"></div>
                            <div class="ks-form-warning" style="display:none;"></div>
                            <div class="ks-tracking-box" style="display:none;">
                              <span class="ks-tracking-label">TRK</span>
                              <span class="ks-tracking-code"></span>
                            </div>
                            <div class="ks-ship-btn-row" style="display:none;">
                              <button type="button" class="ks-btn-primary print-label-btn" data-label-url="">Print
                                Shipping Label</button>
                              <a class="ks-btn-outline label-link" href="#" target="_blank">View</a>
                            </div>
                            <div class="ks-print-status" style="display:none;"></div>
                            <% if order.store_type == 'stripe' %>
                              <!-- Revealed/filled in by the buy-label-form's submit handler once a
                                   label is actually bought this pageview - see
                                   .confirm-shipped-form in the script block below. -->
                              <form class="confirm-shipped-form" action="/confirm_shipped/<%= order.order_number %>"
                                method="post" style="display:none;">
                                <input type="hidden" name="store_key" value="<%= order.store_key %>">
                                <input type="hidden" name="payment_intent_id" value="<%= order.payment_intent_id %>">
                                <input type="hidden" name="carrier" class="confirm-carrier-field" value="">
                                <input type="hidden" name="label_url" class="confirm-label-url-field" value="">
                                <input type="hidden" name="tracking_url" class="confirm-tracking-url-field" value="">
                                <div class="ks-tracking-box">
                                  <span class="ks-tracking-label">TRK</span>
                                  <input class="ks-tracking-code-input confirm-tracking-code-field" type="text"
                                    name="tracking_code" value="" required>
                                </div>
                                <div class="ks-tracking-box">
                                  <span class="ks-tracking-label">EMAIL</span>
                                  <input class="ks-tracking-code-input confirm-email-field" type="text" name="email"
                                    value="<%= order.recipient_email %>" placeholder="customer@example.com">
                                </div>
                                <div class="ks-buy-actions-row">
                                  <button type="submit" class="ks-btn-primary confirm-shipped-btn">Mark as Shipped</button>
                                  <button type="button" class="ks-btn-outline confirm-shipped-info-btn">Info</button>
                                </div>
                                <div class="confirm-shipped-status mark-shipped-status" style="display:none;"></div>
                                <pre class="confirm-shipped-preview" style="display:none;"></pre>
                              </form>
                              <% end %>
                                <% else %>
                        <div class="ks-hint-box">Domestic (US)</div>
                        <form class="buy-label-form" action="/buy_label/<%= order.order_number %>" method="post">
                          <input type="hidden" name="store_type" value="<%= order.store_type %>">
                          <input type="hidden" name="store_key" value="<%= order.store_key %>">
                          <input type="hidden" name="payment_intent_id"
                            value="<%= order.payment_intent_id if order.store_type == 'stripe' %>">
                          <input type="hidden" name="shipping_name" value="<%= order.address_dict[:recipient_name] %>">
                          <input type="hidden" name="shipping_street" value="<%= order.address_dict[:street] %>">
                          <input type="hidden" name="shipping_city" value="<%= order.address_dict[:city] %>">
                          <input type="hidden" name="shipping_state" value="<%= order.address_dict[:state] %>">
                          <input type="hidden" name="shipping_postcode" value="<%= order.address_dict[:postcode] %>">
                          <input type="hidden" name="shipping_country" value="<%= order.address_dict[:country] %>">
                          <input type="hidden" name="shipping_phone"
                            value="<%= order.recipient_phone unless order.recipient_phone.to_s.empty? %>">
                          <input type="hidden" name="email"
                            value="<%= order.recipient_email unless order.recipient_email.to_s.empty? %>">
                          <input type="hidden" name="shipment_id" value="">
                          <input type="hidden" name="carrier" value="usps">
                          <% if is_openspool %>
                            <div class="ks-hint-box">Openspool default box: 6&times;4&times;4 in, 5oz</div>
                            <% else %>
                              <label class="ks-select-label">Box dimensions (in) &amp; weight</label>
                              <div class="ks-dim-row">
                                <input class="ks-input" type="number" step="0.1" min="0.1" name="parcel_length"
                                  placeholder="L" required>
                                <input class="ks-input" type="number" step="0.1" min="0.1" name="parcel_width"
                                  placeholder="W" required>
                                <input class="ks-input" type="number" step="0.1" min="0.1" name="parcel_height"
                                  placeholder="H" required>
                                <div class="ks-weight-field">
                                  <input class="ks-input weight-input" type="number" step="0.1" min="0.1"
                                    placeholder="oz" required>
                                  <div class="ks-unit-toggle">
                                    <button type="button" class="ks-unit-btn ks-unit-btn-active" data-unit="oz">oz</button>
                                    <button type="button" class="ks-unit-btn" data-unit="g">g</button>
                                  </div>
                                  <input type="hidden" name="parcel_weight" class="weight-value">
                                </div>
                              </div>
                              <% end %>
                                <div class="ks-rate-box" style="display:none;"></div>
                                <div class="ks-buy-actions-row">
                                  <button type="button" class="ks-btn-outline rate-check-btn">Check Price</button>
                                  <button type="submit" class="ks-btn-primary">Buy Shipping Label</button>
                                </div>
                        </form>
                        <div class="ks-form-error" style="display:none;"></div>
                        <div class="ks-form-warning" style="display:none;"></div>
                        <div class="ks-tracking-box" style="display:none;">
                          <span class="ks-tracking-label">TRK</span>
                          <span class="ks-tracking-code"></span>
                        </div>
                        <div class="ks-ship-btn-row" style="display:none;">
                          <button type="button" class="ks-btn-primary print-label-btn" data-label-url="">Print Shipping
                            Label</button>
                          <a class="ks-btn-outline label-link" href="#" target="_blank">View</a>
                        </div>
                        <div class="ks-print-status" style="display:none;"></div>
                        <% if order.store_type == 'stripe' %>
                          <!-- Revealed/filled in by the buy-label-form's submit handler once a
                               label is actually bought this pageview - see .confirm-shipped-form
                               in the script block below. -->
                          <form class="confirm-shipped-form" action="/confirm_shipped/<%= order.order_number %>"
                            method="post" style="display:none;">
                            <input type="hidden" name="store_key" value="<%= order.store_key %>">
                            <input type="hidden" name="payment_intent_id" value="<%= order.payment_intent_id %>">
                            <input type="hidden" name="carrier" class="confirm-carrier-field" value="">
                            <input type="hidden" name="label_url" class="confirm-label-url-field" value="">
                            <input type="hidden" name="tracking_url" class="confirm-tracking-url-field" value="">
                            <div class="ks-tracking-box">
                              <span class="ks-tracking-label">TRK</span>
                              <input class="ks-tracking-code-input confirm-tracking-code-field" type="text"
                                name="tracking_code" value="" required>
                            </div>
                            <div class="ks-tracking-box">
                              <span class="ks-tracking-label">EMAIL</span>
                              <input class="ks-tracking-code-input confirm-email-field" type="text" name="email"
                                value="<%= order.recipient_email %>" placeholder="customer@example.com">
                            </div>
                            <div class="ks-buy-actions-row">
                              <button type="submit" class="ks-btn-primary confirm-shipped-btn">Mark as Shipped</button>
                              <button type="button" class="ks-btn-outline confirm-shipped-info-btn">Info</button>
                            </div>
                            <div class="confirm-shipped-status mark-shipped-status" style="display:none;"></div>
                            <pre class="confirm-shipped-preview" style="display:none;"></pre>
                          </form>
                          <% end %>
                            <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
        <% end %>
  </div>

  <div class="ks-footer">
    <span>Synced from <%= stores.map { |s| s[:name] }.join(', ') %></span>
    <span class="ks-footer-mono">
      <%= orders.length %> unshipped orders
    </span>
  </div>

  <script>
    // Reads the response as text first so a non-JSON body (proxy timeout page,
    // crashed server, etc.) surfaces a clear error instead of a cryptic
    // "JSON.parse: unexpected character" from the native parser.
    function parseJsonResponse(response) {
      return response.text().then(function (text) {
        var data;
        try {
          data = text ? JSON.parse(text) : {};
        } catch (e) {
          throw new Error('Server returned an unexpected response (HTTP ' + response.status + '). It may have timed out or crashed.');
        }
        return { ok: response.ok, data: data };
      });
    }

    // Wires up the click-to-expand behavior for order rows - shared by the
    // main table (bound once on load) and the archive table (re-bound each
    // time its rows are fetched/replaced, since they don't exist yet at
    // DOMContentLoaded).
    function bindExpandableRows(root) {
      root.querySelectorAll('.ks-row').forEach(function (row) {
        row.addEventListener('click', function () {
          var target = document.getElementById(row.dataset.target);
          var expanded = row.classList.toggle('ks-row-expanded');
          target.style.display = expanded ? 'block' : 'none';

          // International orders: check the address the first time the row
          // is expanded, not on page load - it's a live EasyPost call per
          // order, so no point paying for it on rows nobody opens.
          if (expanded) {
            var verifyBox = target.querySelector('.ks-verify-box[data-pending="true"]');
            if (verifyBox) verifyAddress(verifyBox);
          }
        });
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      bindExpandableRows(document);
      bindConfirmShippedForms(document);

      // International orders: keep the hidden customs_items field (JSON)
      // in sync with the editable description/HS code/origin/qty/value
      // inputs, so /rate_label and /buy_label always see whatever's
      // currently in the form - not just what CustomsInfoBuilder pre-filled
      // from the catalog/Stripe metadata at page load.
      document.querySelectorAll('.intl-label-form').forEach(function (form) {
        var itemsField = form.querySelector('.customs-items-field');
        var rows = form.querySelectorAll('.ks-customs-row');

        function syncCustomsItems() {
          var items = Array.prototype.map.call(rows, function (row) {
            var item = {};
            row.querySelectorAll('[data-field]').forEach(function (input) {
              item[input.dataset.field] = input.value;
            });
            return item;
          });
          itemsField.value = JSON.stringify(items);
        }

        form.querySelectorAll('[data-field]').forEach(function (input) {
          input.addEventListener('input', syncCustomsItems);
        });

        syncCustomsItems();
      });

      // International orders: proactively verifies the shipping address
      // against EasyPost/carrier data - foreign addresses frequently don't
      // match strict verification (missing region codes, transliteration,
      // unsupported country, etc.) even when they're perfectly
      // deliverable, so this is shown as a heads-up, not a block: the buy
      // button still works either way. Reuses the intl form's own hidden
      // shipping_* fields so what's checked always matches what would
      // actually be bought.
      function verifyAddress(box) {
        var form = box.closest('.ks-detail-box').querySelector('.intl-label-form');
        box.dataset.pending = 'false';
        box.className = 'ks-verify-box';
        box.innerHTML = '<div class="ks-verify-status">Checking address…</div>';

        fetch('/verify_address/' + encodeURIComponent(box.dataset.orderNumber), {
          method: 'POST',
          body: new FormData(form),
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
          .then(parseJsonResponse)
          .then(function (result) {
            var data = result.data;
            if (!result.ok || data.success === false) {
              throw new Error(data.message || 'Address check failed');
            }

            if (data.verified) {
              box.className = 'ks-verify-box ks-verify-ok';
              box.innerHTML = '<div class="ks-verify-status">✓ Address verified by EasyPost</div>';
            } else {
              box.className = 'ks-verify-box ks-verify-warn';
              var html = '<div class="ks-verify-status">⚠️ Address did not verify - double-check it before buying.</div>';
              (data.messages || []).forEach(function (message) {
                html += '<div class="ks-verify-detail">' + message + '</div>';
              });
              if (data.normalized_address) {
                html += '<div class="ks-verify-detail">EasyPost read this as: ' + data.normalized_address + '</div>';
              }
              box.innerHTML = html;
            }
          })
          .catch(function (error) {
            box.className = 'ks-verify-box ks-verify-warn';
            box.innerHTML = '<div class="ks-verify-status">⚠️ Could not check address: ' + error.message + '</div>';
          });
      }

      document.querySelectorAll('.buy-label-form').forEach(function (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          e.stopPropagation();

          var box = form.closest('.ks-detail-box');
          var trackingBox = box.querySelector('.ks-tracking-box');
          var trackingCodeEl = box.querySelector('.ks-tracking-code');
          var btnRow = box.querySelector('.ks-ship-btn-row');
          var printBtn = box.querySelector('.print-label-btn');
          var labelLink = box.querySelector('.label-link');
          var errorBox = box.querySelector('.ks-form-error');
          var warningBox = box.querySelector('.ks-form-warning');
          var submitBtn = form.querySelector('button[type="submit"]');
          var originalLabel = submitBtn.textContent;

          errorBox.style.display = 'none';
          warningBox.style.display = 'none';
          submitBtn.disabled = true;
          submitBtn.textContent = 'Buying Label…';

          fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
          })
            .then(parseJsonResponse)
            .then(function (result) {
              var data = result.data;
              if (!result.ok || data.success === false) {
                throw new Error(data.message || 'Failed to buy shipping label');
              }
              if (data.tracking_code) {
                trackingCodeEl.textContent = data.tracking_code;
                trackingBox.style.display = 'flex';
                form.style.display = 'none';
              }
              if (data.label_url) {
                printBtn.setAttribute('data-label-url', data.label_url);
                labelLink.href = data.label_url;
                btnRow.style.display = 'flex';
              }
              if (data.warning) {
                warningBox.textContent = data.warning;
                warningBox.style.display = 'block';
              }

              // Stripe orders only (see the confirm-shipped-form's own
              // guard in the .rhtml) - carrier/tracking_url are this
              // purchase's actual outcome (ShippingService#buy_shipment),
              // not re-derived from the form, so the confirmation step
              // below always has real data to report.
              //
              // Excludes .mark-shipped-form: the kebab menu's "label
              // bought outside PackPoint" form also carries the
              // .confirm-shipped-form class (they share bindConfirmShippedForms
              // wiring and the /confirm_shipped endpoint) and sits earlier in
              // the DOM, so a plain '.confirm-shipped-form' lookup here would
              // grab it instead of the buy-flow's own form - it has no
              // .confirm-label-url-field/.confirm-tracking-url-field, so
              // filling those in below would throw.
              var confirmForm = box.querySelector('.confirm-shipped-form:not(.mark-shipped-form)');
              if (confirmForm) {
                confirmForm.querySelector('.confirm-tracking-code-field').value = data.tracking_code || '';
                confirmForm.querySelector('.confirm-carrier-field').value = data.carrier || '';
                confirmForm.querySelector('.confirm-label-url-field').value = data.label_url || '';
                confirmForm.querySelector('.confirm-tracking-url-field').value = data.tracking_url || '';
                confirmForm.style.display = 'block';
              }
            })
            .catch(function (error) {
              console.error('Error:', error);
              errorBox.textContent = error.message;
              errorBox.style.display = 'block';
              submitBtn.disabled = false;
              submitBtn.textContent = originalLabel;
            });
        });
      });

      // "Mark as Shipped" after buying a label through PackPoint - the
      // normal path (see POST /confirm_shipped in app.rb). Distinct from
      // the kebab-menu "Mark as Shipped..." form below, which is for labels
      // bought outside PackPoint and never has a carrier to report. Locks
      // in place on success (tracking field read-only, button disabled)
      // rather than reloading, since the order stays visible in the
      // unshipped list until the next real page load either way.
      //
      // Shared by the main table (bound once on load) and the Archive tab's
      // "Resend Shipped Email" form (re-bound each time its rows are
      // fetched/replaced, same as bindExpandableRows above) - both post to
      // the same /confirm_shipped endpoint, just with different starting
      // field values (a fresh buy's vs. hand-typed carrier/tracking/email
      // for an order shipped before this app tracked any of that).
      function bindConfirmShippedForms(root) {
        root.querySelectorAll('.confirm-shipped-form').forEach(function (form) {
        var trackingInput = form.querySelector('.confirm-tracking-code-field');
        var emailInput = form.querySelector('.confirm-email-field');
        var carrierField = form.querySelector('.confirm-carrier-field');
        var submitBtn = form.querySelector('.confirm-shipped-btn');
        var statusBox = form.querySelector('.confirm-shipped-status');

        // Should never happen (every order reaching PackPoint has a
        // recipient email) but if one somehow doesn't, don't let the
        // operator fire a webhook with nowhere to send it - keep the button
        // disabled until an email is typed in.
        function syncSubmitState() {
          submitBtn.disabled = emailInput.value.trim() === '';
        }

        emailInput.addEventListener('input', syncSubmitState);
        syncSubmitState();

        form.addEventListener('submit', function (e) {
          e.preventDefault();

          var originalLabel = submitBtn.textContent;

          statusBox.className = 'confirm-shipped-status mark-shipped-status';
          statusBox.style.display = 'none';
          submitBtn.disabled = true;
          submitBtn.textContent = 'Marking Shipped…';

          fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
          })
            .then(parseJsonResponse)
            .then(function (result) {
              var data = result.data;
              if (!result.ok || data.success === false) {
                throw new Error(data.message || 'Failed to mark as shipped');
              }
              trackingInput.readOnly = true;
              emailInput.readOnly = true;
              // The main table's carrier field is a hidden input (always
              // accurate, set from the buy response); the Archive tab's
              // "Resend Shipped Email" uses a visible <select> instead,
              // which doesn't support readOnly - disabled is the equivalent
              // lock for a <select>, and a no-op either way on a hidden input.
              if (carrierField) carrierField.disabled = true;
              submitBtn.textContent = 'Shipped ✓';
              statusBox.textContent = 'Marked as shipped.';
              statusBox.classList.add('mark-shipped-status-ok');
              statusBox.style.display = 'block';
            })
            .catch(function (error) {
              console.error('Error:', error);
              statusBox.textContent = error.message;
              statusBox.classList.add('mark-shipped-status-error');
              statusBox.style.display = 'block';
              submitBtn.textContent = originalLabel;
              syncSubmitState();
            });
        });

        // "Info" - shows the exact curl command /confirm_shipped's webhook
        // step would send (URL, headers with a redacted secret, JSON body -
        // see OrderStatusNotifier#preview), built from whatever's currently
        // in the form (including hand-edited tracking code/email), without
        // sending it or touching Stripe. Toggles the same box on repeat
        // clicks rather than re-fetching every time.
        var infoBtn = form.querySelector('.confirm-shipped-info-btn');
        var previewBox = form.querySelector('.confirm-shipped-preview');
        var infoLoaded = false;

        infoBtn.addEventListener('click', function () {
          if (infoLoaded) {
            previewBox.style.display = previewBox.style.display === 'none' ? 'block' : 'none';
            return;
          }

          var originalLabel = infoBtn.textContent;
          infoBtn.disabled = true;
          infoBtn.textContent = 'Loading…';

          fetch(form.action + '/preview', {
            method: 'POST',
            body: new FormData(form),
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
          })
            .then(parseJsonResponse)
            .then(function (result) {
              var data = result.data;
              if (!result.ok || data.success === false) {
                throw new Error(data.message || 'Failed to load webhook preview');
              }
              previewBox.textContent = data.configured ? data.curl : '(nothing will be called - ' + data.reason + ')';
              previewBox.style.display = 'block';
              infoLoaded = true;
            })
            .catch(function (error) {
              console.error('Error:', error);
              previewBox.textContent = 'Could not load preview: ' + error.message;
              previewBox.style.display = 'block';
            })
            .finally(function () {
              infoBtn.disabled = false;
              infoBtn.textContent = originalLabel;
            });
        });
      });
      }

      // Weight unit toggle (oz/g). The visible input holds whatever unit is
      // currently selected; ShippingService/EasyPost always want ounces, so
      // the hidden parcel_weight field - the one actually submitted with
      // the form - is kept in ounces regardless of what's displayed.
      // Switching units converts the number already typed rather than
      // clearing it, and re-dispatches 'input' on the hidden field so the
      // rate-invalidation listener wired up below still fires on a unit
      // change, same as it would on any other weight edit.
      var OUNCES_PER_GRAM = 1 / 28.3495;
      var GRAMS_PER_OUNCE = 28.3495;

      document.querySelectorAll('.ks-weight-field').forEach(function (field) {
        var input = field.querySelector('.weight-input');
        var hidden = field.querySelector('.weight-value');
        var buttons = field.querySelectorAll('.ks-unit-btn');
        var unit = 'oz';

        function syncHidden() {
          var value = parseFloat(input.value);
          var ounces = isNaN(value) ? '' : (unit === 'g' ? value * OUNCES_PER_GRAM : value);
          hidden.value = ounces === '' ? '' : Math.round(ounces * 100) / 100;
          hidden.dispatchEvent(new Event('input', { bubbles: true }));
        }

        input.addEventListener('input', syncHidden);

        buttons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            if (btn.dataset.unit === unit) return;

            var value = parseFloat(input.value);
            if (!isNaN(value)) {
              var converted = btn.dataset.unit === 'g' ? value * GRAMS_PER_OUNCE : value * OUNCES_PER_GRAM;
              input.value = Math.round(converted * 10) / 10;
            }

            unit = btn.dataset.unit;
            input.placeholder = unit;
            buttons.forEach(function (b) { b.classList.toggle('ks-unit-btn-active', b === btn); });
            syncHidden();
          });
        });
      });

      // "Check Price" quotes the shipment (creates it, doesn't buy it) so
      // the box dimensions can be priced before committing. The quote's
      // shipment_id is stashed in the form's hidden field so Buy purchases
      // that same shipment - same price, no re-quote. Any edit to the
      // dimension/weight inputs invalidates the stashed quote, since it no
      // longer matches what's typed.
      var CARRIER_LABELS = { usps: 'USPS', fedex: 'FedEx', ups: 'UPS', dhl: 'DHL' };
      // Short monogram shown in the carrier icon badge - see .ks-carrier-icon
      // in style.css for the brand colors keyed off the same carrier codes.
      var CARRIER_MONOGRAMS = { usps: 'US', fedex: 'Fx', ups: 'UPS', dhl: 'DHL' };

      document.querySelectorAll('.buy-label-form').forEach(function (form) {
        var rateBtn = form.querySelector('.rate-check-btn');
        if (!rateBtn) return;

        var rateBox = form.querySelector('.ks-rate-box');
        var shipmentIdField = form.querySelector('input[name="shipment_id"]');
        var carrierField = form.querySelector('input[name="carrier"]');
        var errorBox = form.closest('.ks-detail-box').querySelector('.ks-form-error');
        var originalLabel = rateBtn.textContent;
        var radioName = 'carrier_choice_' + Math.random().toString(36).slice(2);

        function invalidateRate() {
          shipmentIdField.value = '';
          carrierField.value = 'usps';
          rateBox.innerHTML = '';
          rateBox.style.display = 'none';
        }

        form.querySelectorAll('input[name^="parcel_"]').forEach(function (input) {
          input.addEventListener('input', invalidateRate);
        });

        rateBtn.addEventListener('click', function () {
          if (!form.reportValidity()) return;

          errorBox.style.display = 'none';
          rateBtn.disabled = true;
          rateBtn.textContent = 'Checking…';

          fetch(form.action.replace('/buy_label/', '/rate_label/'), {
            method: 'POST',
            body: new FormData(form),
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
          })
            .then(parseJsonResponse)
            .then(function (result) {
              var data = result.data;
              if (!result.ok || data.success === false) {
                throw new Error(data.message || 'Failed to get a price');
              }
              if (!data.rates || !data.rates.length) {
                throw new Error('No rates available for this box/weight');
              }

              shipmentIdField.value = data.shipment_id;
              // Carriers come back USPS-first when available - the first
              // entry is the default selection either way.
              carrierField.value = data.rates[0].carrier;

              rateBox.innerHTML = '';
              data.rates.forEach(function (rate, index) {
                var option = document.createElement('label');
                option.className = 'ks-rate-option';
                option.innerHTML = '<input type="radio" name="' + radioName + '" value="' + rate.carrier + '"' +
                  (index === 0 ? ' checked' : '') + '>' +
                  '<span class="ks-carrier-icon ks-carrier-icon--' + rate.carrier + '">' + (CARRIER_MONOGRAMS[rate.carrier] || '') + '</span>' +
                  '<span class="ks-rate-box-service">' + (CARRIER_LABELS[rate.carrier] || rate.carrier) + ' ' + rate.service + '</span>' +
                  '<span class="ks-rate-box-price">$' + Number(rate.rate).toFixed(2) + '</span>';
                option.querySelector('input').addEventListener('change', function () {
                  carrierField.value = rate.carrier;
                });
                rateBox.appendChild(option);
              });
              rateBox.style.display = 'flex';
            })
            .catch(function (error) {
              console.error('Error:', error);
              errorBox.textContent = error.message;
              errorBox.style.display = 'block';
            })
            .finally(function () {
              rateBtn.disabled = false;
              rateBtn.textContent = originalLabel;
            });
        });
      });

      // "Mark as Shipped" kebab menu (Stripe orders only) - for labels
      // bought outside PackPoint (e.g. directly in EasyPost). Just the
      // open/close/cancel chrome around the form here - submission itself
      // (and its Info preview) is handled by bindConfirmShippedForms, same
      // as every other .confirm-shipped-form, since this one posts to
      // /confirm_shipped too now that it collects carrier/tracking/email.
      document.querySelectorAll('.ks-kebab-wrap').forEach(function (wrap) {
        var kebabBtn = wrap.querySelector('.ks-kebab-btn');
        var menu = wrap.querySelector('.ks-kebab-menu');
        var toggleBtn = wrap.querySelector('.mark-shipped-toggle');
        var form = wrap.querySelector('.mark-shipped-form');
        var cancelBtn = wrap.querySelector('.mark-shipped-cancel');
        var statusBox = wrap.querySelector('.mark-shipped-status');
        var carrierSelect = form.querySelector('.confirm-carrier-field');

        function closeAll() {
          menu.style.display = 'none';
          form.style.display = 'none';
        }

        kebabBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          var expanded = menu.style.display !== 'none';
          closeAll();
          menu.style.display = expanded ? 'none' : 'block';
        });

        toggleBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          menu.style.display = 'none';
          form.style.display = 'block';
          carrierSelect.focus();
        });

        cancelBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          closeAll();
          statusBox.style.display = 'none';
        });

        form.addEventListener('click', function (e) { e.stopPropagation(); });
      });

      // Close any open kebab menu/form when clicking elsewhere on the page.
      document.addEventListener('click', function () {
        document.querySelectorAll('.ks-kebab-menu').forEach(function (menu) { menu.style.display = 'none'; });
        document.querySelectorAll('.mark-shipped-form').forEach(function (form) { form.style.display = 'none'; });
      });

      document.addEventListener('click', function (e) {
        var btn = e.target.closest('.print-label-btn');
        if (!btn) return;
        e.stopPropagation();
        var labelUrl = btn.getAttribute('data-label-url');
        if (!labelUrl) return;

        var statusBox = btn.closest('.ks-detail-box').querySelector('.ks-print-status');
        var originalLabel = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Printing…';
        statusBox.className = 'ks-print-status';
        statusBox.style.display = 'none';

        fetch('/print_label', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ label_url: labelUrl })
        })
          .then(parseJsonResponse)
          .then(function (result) {
            var data = result.data;
            statusBox.textContent = data.message || (data.success ? 'Print job sent' : 'Print failed');
            statusBox.classList.add(data.success ? 'ks-print-status-ok' : 'ks-print-status-error');
            statusBox.style.display = 'block';
          })
          .catch(function (error) {
            console.error('Error:', error);
            statusBox.textContent = 'Print failed: ' + error.message;
            statusBox.classList.add('ks-print-status-error');
            statusBox.style.display = 'block';
          })
          .finally(function () {
            btn.disabled = false;
            btn.textContent = originalLabel;
          });
      });

      // Archive tab: fetched lazily on first open, then cached client-side
      // so re-toggling doesn't re-fetch. "Refresh" forces a re-fetch.
      var archiveToggle = document.getElementById('archive-toggle');
      var archiveSection = document.getElementById('archive-section');
      var archiveContent = document.getElementById('archive-content');
      var archiveRefresh = document.getElementById('archive-refresh');
      var archiveLoaded = false;

      function loadArchive() {
        archiveContent.innerHTML = '<div class="ks-hint-box">Loading…</div>';
        fetch('/orders/archive', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
          .then(function (response) {
            if (!response.ok) throw new Error('HTTP ' + response.status);
            return response.text();
          })
          .then(function (html) {
            archiveContent.innerHTML = html;
            bindExpandableRows(archiveContent);
            bindConfirmShippedForms(archiveContent);
            archiveLoaded = true;
            archiveRefresh.style.display = 'inline-block';
          })
          .catch(function (error) {
            console.error('Error loading archive:', error);
            archiveContent.innerHTML = '<div class="ks-form-error">Failed to load archive: ' + error.message + '</div>';
          });
      }

      archiveToggle.addEventListener('click', function () {
        var expanded = archiveSection.style.display !== 'none';
        archiveSection.style.display = expanded ? 'none' : 'block';
        archiveToggle.textContent = expanded ? 'Archive ▸' : 'Archive ▾';
        if (!expanded && !archiveLoaded) loadArchive();
      });

      archiveRefresh.addEventListener('click', loadArchive);

      // Theme toggle
      var root = document.documentElement;
      var stored = localStorage.getItem('packpoint-theme');
      if (stored) root.dataset.theme = stored;

      function updateThemeButtons() {
        var mode = root.dataset.theme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.querySelectorAll('.ks-theme-btn').forEach(function (btn) {
          btn.classList.toggle('ks-theme-btn-active', btn.dataset.themeChoice === mode);
        });
      }

      document.querySelectorAll('.ks-theme-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          root.dataset.theme = btn.dataset.themeChoice;
          localStorage.setItem('packpoint-theme', btn.dataset.themeChoice);
          updateThemeButtons();
        });
      });

      updateThemeButtons();
    });
  </script>