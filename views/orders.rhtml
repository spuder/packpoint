<header class="ks-header">
  <div class="ks-brand">
    <div class="ks-logo">P</div>
    <div>
      <div class="ks-brand-name">PackPoint</div>
      <div class="ks-brand-sub">Shipping Station · STN-01</div>
    </div>
  </div>

  <div class="ks-header-right">
    <% if ENV['APP_ENV']=='development' %>
      <div class="ks-dev-badge">Development</div>
      <% end %>

        <div class="ks-printer-pill <%= printer_available ? '' : 'ks-pill-error' %>">
          <span class="ks-dot"></span>
          <span>
            <% if printer_available %>
              PM-241-BT Ready
              <% elsif printer_error %>
                PM-241-BT Error: <%= printer_error %>
                  <% else %>
                    PM-241-BT Not Available
                    <% end %>
          </span>
        </div>

        <div class="ks-theme-toggle">
          <button type="button" class="ks-theme-btn" data-theme-choice="light">Light</button>
          <button type="button" class="ks-theme-btn" data-theme-choice="dark">Dark</button>
        </div>
  </div>
</header>

<% if stripe_warnings&.any? %>
  <div class="ks-warning-banner">
    <% stripe_warnings.each do |warning| %>
      <div class="ks-warning-row">⚠️ <%= warning %></div>
      <% end %>
  </div>
  <% end %>

<% aging_count=orders.count { |order| order_aging?(order.date) } %>
  <div class="ks-subbar">
    <div class="ks-store-tabs">
      <% stores.each do |store| %>
        <div class="ks-tab">
          <span class="ks-tab-dot"></span>
          <span><%= store[:name] %></span>
          <span class="ks-tab-count">
            <%= store[:count] %>
          </span>
        </div>
        <% end %>
    </div>

    <div class="ks-subbar-right">
      <div class="ks-stat">
        <span class="ks-stat-num">
          <%= orders.count { |order| !order.shipped } %>
        </span>
        <span class="ks-stat-label">unshipped</span>
      </div>
      <div class="ks-aging <%= 'ks-aging-active' if aging_count > 0 %>">
        <span class="ks-aging-num">
          <%= aging_count %>
        </span> aging &gt; 48h
      </div>
      <button type="button" class="ks-btn-outline" id="archive-toggle">Archive ▸</button>
    </div>
  </div>

  <div id="archive-section" style="display:none;">
    <div class="ks-archive-header">
      <span>Shipped in the last <%= archive_days %> days</span>
      <button type="button" class="ks-btn-ghost" id="archive-refresh" style="display:none;">Refresh</button>
    </div>
    <div id="archive-content"></div>
  </div>

  <div class="ks-table">
    <div class="ks-col-header">
      <div></div>
      <div>Product</div>
      <div>Store</div>
      <div>Order</div>
      <div>Age</div>
      <div>Recipient</div>
      <div>Destination</div>
      <div class="ks-col-right">Label</div>
    </div>

    <% orders.sort_by { |order| order.date.to_time }.each do |order| %>
      <% status = order_status(order); label = purchased_labels[order.order_number.to_s]; total_qty = order.products.sum(&:qty); total_price = order.products.sum { |p| p.price.to_f }; is_openspool = order.products.any? { |p| p.name.to_s.downcase.include?('openspool') } %>
        <div class="ks-row-wrap">
          <div class="ks-row" data-target="details-<%= order.order_number %>">
            <div class="ks-chevron">▸</div>
            <div>
              <div class="ks-product-name">
                <%= order.products.map(&:name).join(", ") %></div>
          <div class=" ks-product-sub">
                  <%= total_qty %>
                    <%= total_qty==1 ? 'item' : 'items' %> · $<%= '%.2f' % total_price %>
              </div>
            </div>
            <div>
              <span class="ks-store-badge"><span class="ks-store-dot"></span><%= order.store_display_name %></span>
            </div>
            <div class="ks-order-no" title="<%= order.order_number %>">
              <%= display_order_number(order) %>
            </div>
            <div class="ks-age <%= 'ks-age-hot' if order_aging?(order.date) %>">
              <%= order_age(order.date) %>
            </div>
            <div class="ks-recipient">
              <%= order.address_dict[:recipient_name] %>
            </div>
            <div class="ks-destination">
              <span class="ks-flag">
                <%= countries[order.address_dict[:country_code]] %>
              </span>
              <span>
                <%= order.address_dict[:country] %>
              </span>
            </div>
            <div class="ks-label-col">
              <span class="ks-status-pill ks-status-<%= status %>">
                <% if status=='need' %>
                  Needs label
                  <% elsif status=='ready' %>
                    Label ready
                    <% else %>
                      International
                      <% end %>
              </span>
            </div>
          </div>

          <div class="ks-detail" id="details-<%= order.order_number %>" style="display:none;">
            <div class="ks-detail-grid">
              <div class="ks-detail-box">
                <div class="ks-detail-box-head">
                  <div class="ks-detail-box-title">Items</div>
                  <div class="ks-detail-order-no" title="<%= order.order_number %>">
                    <%= display_order_number(order) %>
                  </div>
                </div>
                <% order.products.each do |item| %>
                  <div class="ks-item-row">
                    <span class="ks-qty-badge <%= 'ks-qty-badge-multi' if item.qty > 1 %>">&times;<%= item.qty %></span>
                    <div class="ks-item-info">
                      <div class="ks-item-name">
                        <%= item.name %>
                      </div>
                      <div class="ks-item-opt">
                        <%= item.options %>
                      </div>
                    </div>
                    <div class="ks-item-price">$<%= '%.2f' % item.price %>
                    </div>
                  </div>
                  <% end %>
                    <div class="ks-item-actions">
                      <% if order.store_type=='tindie' %>
                        <a class="ks-btn-outline" href="https://www.tindie.com/orders/print/<%= order.order_number %>"
                          onclick="window.open(this.href, '_blank'); return false;">Print Packing Slip</a>
                        <button type="button" class="ks-btn-ghost"
                          onclick="window.open('https://www.tindie.com/orders/print/<%= order.order_number %>/?api_key=<%= api_key %>&username=<%= username %>', '_blank')">View
                          Slip &rarr;</button>
                        <% else %>
                          <button type="button" class="ks-btn-ghost"
                            onclick="window.open('https://dashboard.stripe.com/payments/<%= order.payment_intent_id %>', '_blank')">View
                            in Stripe &rarr;</button>
                          <% end %>
                    </div>
              </div>

              <div class="ks-detail-box">
                <div class="ks-detail-box-head">
                  <div class="ks-detail-box-title">Ship To</div>
                  <% if order.store_type == 'stripe' %>
                    <div class="ks-kebab-wrap">
                      <button type="button" class="ks-kebab-btn" aria-label="More actions">&#8942;</button>
                      <div class="ks-kebab-menu" style="display:none;">
                        <button type="button" class="ks-kebab-item mark-shipped-toggle">Mark as Shipped&hellip;</button>
                      </div>
                      <form class="mark-shipped-form" action="/mark_shipped/<%= order.order_number %>" method="post"
                        style="display:none;">
                        <input type="hidden" name="store_key" value="<%= order.store_key %>">
                        <input type="hidden" name="payment_intent_id" value="<%= order.payment_intent_id %>">
                        <label class="ks-select-label">Tracking code (bought outside PackPoint)</label>
                        <input class="ks-input" type="text" name="tracking_code" placeholder="Tracking code" required>
                        <div class="mark-shipped-status" style="display:none;"></div>
                        <div class="ks-buy-actions-row">
                          <button type="button" class="ks-btn-outline mark-shipped-cancel">Cancel</button>
                          <button type="submit" class="ks-btn-primary">Confirm</button>
                        </div>
                      </form>
                    </div>
                    <% end %>
                </div>
                <div class="ks-ship-address">
                  <div class="ks-ship-name">
                    <%= order.address_dict[:recipient_name] %>
                  </div>
                  <div class="ks-ship-muted">
                    <%= order.address_dict[:street] %>
                  </div>
                  <div class="ks-ship-muted">
                    <%= order.address_dict[:city] %>, <%= order.address_dict[:state] %>
                        <%= order.address_dict[:postcode] %>
                  </div>
                  <div class="ks-ship-country">
                    <span class="ks-flag">
                      <%= countries[order.address_dict[:country_code]] %>
                    </span>
                    <span>
                      <%= order.address_dict[:country] %>
                    </span>
                  </div>
                </div>

                <div class="ks-ship-action">
                  <% if status=='ready' && label %>
                    <div class="ks-tracking-box">
                      <span class="ks-tracking-label">TRK</span>
                      <span class="ks-tracking-code">
                        <%= label[:tracking_code] %>
                      </span>
                    </div>
                    <div class="ks-ship-btn-row">
                      <button type="button" class="ks-btn-primary print-label-btn"
                        data-label-url="<%= label[:label_url] %>">Print Shipping Label</button>
                      <a class="ks-btn-outline label-link" href="<%= label[:label_url] %>" target="_blank">View</a>
                    </div>
                    <div class="ks-print-status" style="display:none;"></div>
                    <% elsif status=='intl' %>
                      <div class="ks-hint-box">International destination · customs required. Process via EasyPost.</div>
                      <a class="ks-btn-intl" href="https://www.easypost.com" target="_blank">Ship Internationally
                        &rarr;</a>
                      <% else %>
                        <div class="ks-hint-box">Domestic (US)</div>
                        <form class="buy-label-form" action="/buy_label/<%= order.order_number %>" method="post">
                          <input type="hidden" name="store_type" value="<%= order.store_type %>">
                          <input type="hidden" name="store_key" value="<%= order.store_key %>">
                          <input type="hidden" name="payment_intent_id"
                            value="<%= order.payment_intent_id if order.store_type == 'stripe' %>">
                          <input type="hidden" name="shipping_name" value="<%= order.address_dict[:recipient_name] %>">
                          <input type="hidden" name="shipping_street" value="<%= order.address_dict[:street] %>">
                          <input type="hidden" name="shipping_city" value="<%= order.address_dict[:city] %>">
                          <input type="hidden" name="shipping_state" value="<%= order.address_dict[:state] %>">
                          <input type="hidden" name="shipping_postcode" value="<%= order.address_dict[:postcode] %>">
                          <input type="hidden" name="shipping_country" value="<%= order.address_dict[:country] %>">
                          <input type="hidden" name="shipping_phone"
                            value="<%= order.recipient_phone unless order.recipient_phone.to_s.empty? %>">
                          <input type="hidden" name="email"
                            value="<%= order.recipient_email unless order.recipient_email.to_s.empty? %>">
                          <input type="hidden" name="shipment_id" value="">
                          <input type="hidden" name="carrier" value="usps">
                          <% if is_openspool %>
                            <div class="ks-hint-box">Openspool default box: 6&times;4&times;4 in, 5oz</div>
                            <% else %>
                              <label class="ks-select-label">Box dimensions (in) &amp; weight</label>
                              <div class="ks-dim-row">
                                <input class="ks-input" type="number" step="0.1" min="0.1" name="parcel_length"
                                  placeholder="L" required>
                                <input class="ks-input" type="number" step="0.1" min="0.1" name="parcel_width"
                                  placeholder="W" required>
                                <input class="ks-input" type="number" step="0.1" min="0.1" name="parcel_height"
                                  placeholder="H" required>
                                <div class="ks-weight-field">
                                  <input class="ks-input weight-input" type="number" step="0.1" min="0.1"
                                    placeholder="oz" required>
                                  <div class="ks-unit-toggle">
                                    <button type="button" class="ks-unit-btn ks-unit-btn-active" data-unit="oz">oz</button>
                                    <button type="button" class="ks-unit-btn" data-unit="g">g</button>
                                  </div>
                                  <input type="hidden" name="parcel_weight" class="weight-value">
                                </div>
                              </div>
                              <% end %>
                                <div class="ks-rate-box" style="display:none;"></div>
                                <div class="ks-buy-actions-row">
                                  <button type="button" class="ks-btn-outline rate-check-btn">Check Price</button>
                                  <button type="submit" class="ks-btn-primary">Buy Shipping Label</button>
                                </div>
                        </form>
                        <div class="ks-form-error" style="display:none;"></div>
                        <div class="ks-form-warning" style="display:none;"></div>
                        <div class="ks-tracking-box" style="display:none;">
                          <span class="ks-tracking-label">TRK</span>
                          <span class="ks-tracking-code"></span>
                        </div>
                        <div class="ks-ship-btn-row" style="display:none;">
                          <button type="button" class="ks-btn-primary print-label-btn" data-label-url="">Print Shipping
                            Label</button>
                          <a class="ks-btn-outline label-link" href="#" target="_blank">View</a>
                        </div>
                        <div class="ks-print-status" style="display:none;"></div>
                        <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
        <% end %>
  </div>

  <div class="ks-footer">
    <span>Synced from <%= stores.map { |s| s[:name] }.join(', ') %></span>
    <span class="ks-footer-mono">
      <%= orders.length %> unshipped orders
    </span>
  </div>

  <script>
    // Reads the response as text first so a non-JSON body (proxy timeout page,
    // crashed server, etc.) surfaces a clear error instead of a cryptic
    // "JSON.parse: unexpected character" from the native parser.
    function parseJsonResponse(response) {
      return response.text().then(function (text) {
        var data;
        try {
          data = text ? JSON.parse(text) : {};
        } catch (e) {
          throw new Error('Server returned an unexpected response (HTTP ' + response.status + '). It may have timed out or crashed.');
        }
        return { ok: response.ok, data: data };
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.ks-row').forEach(function (row) {
        row.addEventListener('click', function () {
          var target = document.getElementById(row.dataset.target);
          var expanded = row.classList.toggle('ks-row-expanded');
          target.style.display = expanded ? 'block' : 'none';
        });
      });

      document.querySelectorAll('.buy-label-form').forEach(function (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          e.stopPropagation();

          var box = form.closest('.ks-detail-box');
          var trackingBox = box.querySelector('.ks-tracking-box');
          var trackingCodeEl = box.querySelector('.ks-tracking-code');
          var btnRow = box.querySelector('.ks-ship-btn-row');
          var printBtn = box.querySelector('.print-label-btn');
          var labelLink = box.querySelector('.label-link');
          var errorBox = box.querySelector('.ks-form-error');
          var warningBox = box.querySelector('.ks-form-warning');
          var submitBtn = form.querySelector('button[type="submit"]');
          var originalLabel = submitBtn.textContent;

          errorBox.style.display = 'none';
          warningBox.style.display = 'none';
          submitBtn.disabled = true;
          submitBtn.textContent = 'Buying Label…';

          fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
          })
            .then(parseJsonResponse)
            .then(function (result) {
              var data = result.data;
              if (!result.ok || data.success === false) {
                throw new Error(data.message || 'Failed to buy shipping label');
              }
              if (data.tracking_code) {
                trackingCodeEl.textContent = data.tracking_code;
                trackingBox.style.display = 'flex';
                form.style.display = 'none';
              }
              if (data.label_url) {
                printBtn.setAttribute('data-label-url', data.label_url);
                labelLink.href = data.label_url;
                btnRow.style.display = 'flex';
              }
              if (data.warning) {
                warningBox.textContent = data.warning;
                warningBox.style.display = 'block';
              }
            })
            .catch(function (error) {
              console.error('Error:', error);
              errorBox.textContent = error.message;
              errorBox.style.display = 'block';
              submitBtn.disabled = false;
              submitBtn.textContent = originalLabel;
            });
        });
      });

      // Weight unit toggle (oz/g). The visible input holds whatever unit is
      // currently selected; ShippingService/EasyPost always want ounces, so
      // the hidden parcel_weight field - the one actually submitted with
      // the form - is kept in ounces regardless of what's displayed.
      // Switching units converts the number already typed rather than
      // clearing it, and re-dispatches 'input' on the hidden field so the
      // rate-invalidation listener wired up below still fires on a unit
      // change, same as it would on any other weight edit.
      var OUNCES_PER_GRAM = 1 / 28.3495;
      var GRAMS_PER_OUNCE = 28.3495;

      document.querySelectorAll('.ks-weight-field').forEach(function (field) {
        var input = field.querySelector('.weight-input');
        var hidden = field.querySelector('.weight-value');
        var buttons = field.querySelectorAll('.ks-unit-btn');
        var unit = 'oz';

        function syncHidden() {
          var value = parseFloat(input.value);
          var ounces = isNaN(value) ? '' : (unit === 'g' ? value * OUNCES_PER_GRAM : value);
          hidden.value = ounces === '' ? '' : Math.round(ounces * 100) / 100;
          hidden.dispatchEvent(new Event('input', { bubbles: true }));
        }

        input.addEventListener('input', syncHidden);

        buttons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            if (btn.dataset.unit === unit) return;

            var value = parseFloat(input.value);
            if (!isNaN(value)) {
              var converted = btn.dataset.unit === 'g' ? value * GRAMS_PER_OUNCE : value * OUNCES_PER_GRAM;
              input.value = Math.round(converted * 10) / 10;
            }

            unit = btn.dataset.unit;
            input.placeholder = unit;
            buttons.forEach(function (b) { b.classList.toggle('ks-unit-btn-active', b === btn); });
            syncHidden();
          });
        });
      });

      // "Check Price" quotes the shipment (creates it, doesn't buy it) so
      // the box dimensions can be priced before committing. The quote's
      // shipment_id is stashed in the form's hidden field so Buy purchases
      // that same shipment - same price, no re-quote. Any edit to the
      // dimension/weight inputs invalidates the stashed quote, since it no
      // longer matches what's typed.
      var CARRIER_LABELS = { usps: 'USPS', fedex: 'FedEx', ups: 'UPS' };
      // Short monogram shown in the carrier icon badge - see .ks-carrier-icon
      // in style.css for the brand colors keyed off the same carrier codes.
      var CARRIER_MONOGRAMS = { usps: 'US', fedex: 'Fx', ups: 'UPS', dhl: 'DHL' };

      document.querySelectorAll('.buy-label-form').forEach(function (form) {
        var rateBtn = form.querySelector('.rate-check-btn');
        if (!rateBtn) return;

        var rateBox = form.querySelector('.ks-rate-box');
        var shipmentIdField = form.querySelector('input[name="shipment_id"]');
        var carrierField = form.querySelector('input[name="carrier"]');
        var errorBox = form.closest('.ks-detail-box').querySelector('.ks-form-error');
        var originalLabel = rateBtn.textContent;
        var radioName = 'carrier_choice_' + Math.random().toString(36).slice(2);

        function invalidateRate() {
          shipmentIdField.value = '';
          carrierField.value = 'usps';
          rateBox.innerHTML = '';
          rateBox.style.display = 'none';
        }

        form.querySelectorAll('input[name^="parcel_"]').forEach(function (input) {
          input.addEventListener('input', invalidateRate);
        });

        rateBtn.addEventListener('click', function () {
          if (!form.reportValidity()) return;

          errorBox.style.display = 'none';
          rateBtn.disabled = true;
          rateBtn.textContent = 'Checking…';

          fetch(form.action.replace('/buy_label/', '/rate_label/'), {
            method: 'POST',
            body: new FormData(form),
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
          })
            .then(parseJsonResponse)
            .then(function (result) {
              var data = result.data;
              if (!result.ok || data.success === false) {
                throw new Error(data.message || 'Failed to get a price');
              }
              if (!data.rates || !data.rates.length) {
                throw new Error('No rates available for this box/weight');
              }

              shipmentIdField.value = data.shipment_id;
              // Carriers come back USPS-first when available - the first
              // entry is the default selection either way.
              carrierField.value = data.rates[0].carrier;

              rateBox.innerHTML = '';
              data.rates.forEach(function (rate, index) {
                var option = document.createElement('label');
                option.className = 'ks-rate-option';
                option.innerHTML = '<input type="radio" name="' + radioName + '" value="' + rate.carrier + '"' +
                  (index === 0 ? ' checked' : '') + '>' +
                  '<span class="ks-carrier-icon ks-carrier-icon--' + rate.carrier + '">' + (CARRIER_MONOGRAMS[rate.carrier] || '') + '</span>' +
                  '<span class="ks-rate-box-service">' + (CARRIER_LABELS[rate.carrier] || rate.carrier) + ' ' + rate.service + '</span>' +
                  '<span class="ks-rate-box-price">$' + Number(rate.rate).toFixed(2) + '</span>';
                option.querySelector('input').addEventListener('change', function () {
                  carrierField.value = rate.carrier;
                });
                rateBox.appendChild(option);
              });
              rateBox.style.display = 'flex';
            })
            .catch(function (error) {
              console.error('Error:', error);
              errorBox.textContent = error.message;
              errorBox.style.display = 'block';
            })
            .finally(function () {
              rateBtn.disabled = false;
              rateBtn.textContent = originalLabel;
            });
        });
      });

      // "Mark as Shipped" kebab menu (Stripe orders only) - for labels
      // bought outside PackPoint (e.g. directly in EasyPost). Writes real
      // fulfillment metadata to the Checkout Session via /mark_shipped; the
      // order drops off the unshipped list on next load, so a full reload
      // on success is simpler than patching the row in place.
      document.querySelectorAll('.ks-kebab-wrap').forEach(function (wrap) {
        var kebabBtn = wrap.querySelector('.ks-kebab-btn');
        var menu = wrap.querySelector('.ks-kebab-menu');
        var toggleBtn = wrap.querySelector('.mark-shipped-toggle');
        var form = wrap.querySelector('.mark-shipped-form');
        var cancelBtn = wrap.querySelector('.mark-shipped-cancel');
        var statusBox = wrap.querySelector('.mark-shipped-status');
        var trackingInput = form.querySelector('input[name="tracking_code"]');
        var submitBtn = form.querySelector('button[type="submit"]');

        function closeAll() {
          menu.style.display = 'none';
          form.style.display = 'none';
        }

        kebabBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          var expanded = menu.style.display !== 'none';
          closeAll();
          menu.style.display = expanded ? 'none' : 'block';
        });

        toggleBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          menu.style.display = 'none';
          form.style.display = 'block';
          trackingInput.focus();
        });

        cancelBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          closeAll();
          trackingInput.value = '';
          statusBox.style.display = 'none';
        });

        form.addEventListener('click', function (e) { e.stopPropagation(); });

        form.addEventListener('submit', function (e) {
          e.preventDefault();
          statusBox.className = 'mark-shipped-status';
          statusBox.style.display = 'none';
          submitBtn.disabled = true;
          submitBtn.textContent = 'Saving…';

          fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
          })
            .then(parseJsonResponse)
            .then(function (result) {
              var data = result.data;
              if (!result.ok || data.success === false) {
                throw new Error(data.message || 'Failed to mark as shipped');
              }
              statusBox.textContent = 'Marked as shipped. Reloading…';
              statusBox.classList.add('mark-shipped-status-ok');
              statusBox.style.display = 'block';
              setTimeout(function () { window.location.reload(); }, 800);
            })
            .catch(function (error) {
              console.error('Error:', error);
              statusBox.textContent = error.message;
              statusBox.classList.add('mark-shipped-status-error');
              statusBox.style.display = 'block';
              submitBtn.disabled = false;
              submitBtn.textContent = 'Confirm';
            });
        });
      });

      // Close any open kebab menu/form when clicking elsewhere on the page.
      document.addEventListener('click', function () {
        document.querySelectorAll('.ks-kebab-menu').forEach(function (menu) { menu.style.display = 'none'; });
        document.querySelectorAll('.mark-shipped-form').forEach(function (form) { form.style.display = 'none'; });
      });

      document.addEventListener('click', function (e) {
        var btn = e.target.closest('.print-label-btn');
        if (!btn) return;
        e.stopPropagation();
        var labelUrl = btn.getAttribute('data-label-url');
        if (!labelUrl) return;

        var statusBox = btn.closest('.ks-detail-box').querySelector('.ks-print-status');
        var originalLabel = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Printing…';
        statusBox.className = 'ks-print-status';
        statusBox.style.display = 'none';

        fetch('/print_label', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ label_url: labelUrl })
        })
          .then(parseJsonResponse)
          .then(function (result) {
            var data = result.data;
            statusBox.textContent = data.message || (data.success ? 'Print job sent' : 'Print failed');
            statusBox.classList.add(data.success ? 'ks-print-status-ok' : 'ks-print-status-error');
            statusBox.style.display = 'block';
          })
          .catch(function (error) {
            console.error('Error:', error);
            statusBox.textContent = 'Print failed: ' + error.message;
            statusBox.classList.add('ks-print-status-error');
            statusBox.style.display = 'block';
          })
          .finally(function () {
            btn.disabled = false;
            btn.textContent = originalLabel;
          });
      });

      // Archive tab: fetched lazily on first open, then cached client-side
      // so re-toggling doesn't re-fetch. "Refresh" forces a re-fetch.
      var archiveToggle = document.getElementById('archive-toggle');
      var archiveSection = document.getElementById('archive-section');
      var archiveContent = document.getElementById('archive-content');
      var archiveRefresh = document.getElementById('archive-refresh');
      var archiveLoaded = false;

      function loadArchive() {
        archiveContent.innerHTML = '<div class="ks-hint-box">Loading…</div>';
        fetch('/orders/archive', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
          .then(function (response) {
            if (!response.ok) throw new Error('HTTP ' + response.status);
            return response.text();
          })
          .then(function (html) {
            archiveContent.innerHTML = html;
            archiveLoaded = true;
            archiveRefresh.style.display = 'inline-block';
          })
          .catch(function (error) {
            console.error('Error loading archive:', error);
            archiveContent.innerHTML = '<div class="ks-form-error">Failed to load archive: ' + error.message + '</div>';
          });
      }

      archiveToggle.addEventListener('click', function () {
        var expanded = archiveSection.style.display !== 'none';
        archiveSection.style.display = expanded ? 'none' : 'block';
        archiveToggle.textContent = expanded ? 'Archive ▸' : 'Archive ▾';
        if (!expanded && !archiveLoaded) loadArchive();
      });

      archiveRefresh.addEventListener('click', loadArchive);

      // Theme toggle
      var root = document.documentElement;
      var stored = localStorage.getItem('packpoint-theme');
      if (stored) root.dataset.theme = stored;

      function updateThemeButtons() {
        var mode = root.dataset.theme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.querySelectorAll('.ks-theme-btn').forEach(function (btn) {
          btn.classList.toggle('ks-theme-btn-active', btn.dataset.themeChoice === mode);
        });
      }

      document.querySelectorAll('.ks-theme-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          root.dataset.theme = btn.dataset.themeChoice;
          localStorage.setItem('packpoint-theme', btn.dataset.themeChoice);
          updateThemeButtons();
        });
      });

      updateThemeButtons();
    });
  </script>