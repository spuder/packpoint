TINDIE_USERNAME=xxxxx
TINDIE_API_KEY=xxxxxx
EASYPOST_API_KEY=xxxxxx

# EasyPost address ID (adr_...) that Tindie orders should ship from.
TINDIE_EASYPOST_FROM_ADDRESS=adr_xxxxxxxx

CUPS_HOST=192.186.0.2

# International shipping (optional). CUSTOMS_SIGNER_NAME is who certifies
# the customs form EasyPost generates - defaults to the shipping store's
# return address name if unset. CUSTOMS_CATALOG_PATH overrides where Tindie
# product customs metadata (HS code/origin country/description) is loaded
# from - defaults to config/customs_catalog.yml. See that file for format.
# CUSTOMS_SIGNER_NAME=Jane Seller
# CUSTOMS_CATALOG_PATH=config/customs_catalog.yml

# Stripe is optional. Add one NAME/SECRET_KEY/EASYPOST_FROM_ADDRESS trio per
# store you want to pull orders from - they all share one PackPoint account.
# The id in the middle (1, 2, main, ...) just has to be unique and match
# across all three vars for a given store. EASYPOST_FROM_ADDRESS is the
# EasyPost address ID (adr_...) that store's orders should ship from.
STRIPE_STORE_1_NAME=My Shop
STRIPE_STORE_1_SECRET_KEY=sk_live_xxxxxxxx
STRIPE_STORE_1_EASYPOST_FROM_ADDRESS=adr_xxxxxxxx
STRIPE_STORE_2_NAME=Side Project
STRIPE_STORE_2_SECRET_KEY=sk_live_yyyyyyyy
STRIPE_STORE_2_EASYPOST_FROM_ADDRESS=adr_yyyyyyyy

# Order-status webhook (optional, Stripe stores only - see
# ShippingApp::OrderStatusNotifier). Fired whenever an order is confirmed
# shipped - either right after buying a label through PackPoint (carrier/
# tracking pre-filled from that purchase), or via the "Mark as Shipped..."
# kebab-menu option for a label bought outside PackPoint, where the operator
# types in the carrier/tracking/email by hand instead. Missing/unset vars
# are skipped (logged, not fatal) rather than breaking the shipment that
# already went through. Per-store, using the same STRIPE_STORE_<id>_ prefix
# as above - the pattern leaves room for other store types (e.g. Etsy) to
# add their own later.
#
# PackPoint doesn't send the customer email itself - it POSTs a JSON
# "shipped" event to a listener you run for that store, with the secret sent
# as `Authorization: Bearer <secret>`; the receiving store is expected to
# send its own email from there (e.g. via its own Resend integration). Both
# vars must be set together, or the webhook is skipped.
STRIPE_STORE_1_ORDER_STATUS_WEBHOOK_URL=https://example.com/api/order-status
STRIPE_STORE_1_ORDER_STATUS_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_STORE_2_ORDER_STATUS_WEBHOOK_URL=https://side-project.example.com/api/order-status
STRIPE_STORE_2_ORDER_STATUS_WEBHOOK_SECRET=whsec_yyyyyyyy
