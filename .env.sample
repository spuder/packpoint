TINDIE_USERNAME=xxxxx
TINDIE_API_KEY=xxxxxx
EASYPOST_API_KEY=xxxxxx

# EasyPost address ID (adr_...) that Tindie orders should ship from.
TINDIE_EASYPOST_FROM_ADDRESS=adr_xxxxxxxx

CUPS_HOST=192.186.0.2

# International shipping (optional). CUSTOMS_SIGNER_NAME is who certifies
# the customs form EasyPost generates - defaults to the shipping store's
# return address name if unset. CUSTOMS_CATALOG_PATH overrides where Tindie
# product customs metadata (HS code/origin country/description) is loaded
# from - defaults to config/customs_catalog.yml. See that file for format.
# CUSTOMS_SIGNER_NAME=Jane Seller
# CUSTOMS_CATALOG_PATH=config/customs_catalog.yml

# Stripe is optional. Add one NAME/SECRET_KEY/EASYPOST_FROM_ADDRESS trio per
# store you want to pull orders from - they all share one PackPoint account.
# The id in the middle (1, 2, main, ...) just has to be unique and match
# across all three vars for a given store. EASYPOST_FROM_ADDRESS is the
# EasyPost address ID (adr_...) that store's orders should ship from.
STRIPE_STORE_1_NAME=My Shop
STRIPE_STORE_1_SECRET_KEY=sk_live_xxxxxxxx
STRIPE_STORE_1_EASYPOST_FROM_ADDRESS=adr_xxxxxxxx
STRIPE_STORE_2_NAME=Side Project
STRIPE_STORE_2_SECRET_KEY=sk_live_yyyyyyyy
STRIPE_STORE_2_EASYPOST_FROM_ADDRESS=adr_yyyyyyyy

# Etsy is optional and can pull orders from multiple Etsy shops at once -
# add a NAME/SHOP_ID/API_KEY/ACCESS_TOKEN/REFRESH_TOKEN group per shop (the
# id in the middle just has to be unique and match across all vars for a
# given shop). API_KEY/SHARED_SECRET come from registering an app at
# https://www.etsy.com/developers/your-apps; ACCESS_TOKEN/REFRESH_TOKEN come
# from completing Etsy's OAuth flow once - `ruby bin/etsy_oauth API_KEY
# SHOP_ID` walks you through it and prints these lines. PackPoint refreshes
# the access token automatically after that (see EtsyClient) - the ENV
# values just need to be valid the first time the app starts.
#
# RATE_SOURCE picks how shipping is priced/bought for that shop's orders:
#   easypost (default) - same EasyPost rate-shop-and-buy flow as Tindie/
#     Stripe orders. Requires EASYPOST_FROM_ADDRESS (an EasyPost address ID,
#     adr_..., for the address that shop's orders ship from).
#   etsy - the shop buys its own postage directly on Etsy.com (Etsy's
#     built-in USPS/UPS pricing). PackPoint shows the shipping price the
#     buyer already paid and offers "Mark as Shipped" instead of buying a
#     label. No EASYPOST_FROM_ADDRESS needed.
ETSY_STORE_1_NAME=My Etsy Shop
ETSY_STORE_1_SHOP_ID=12345678
ETSY_STORE_1_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxx
# ETSY_STORE_1_SHARED_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxx
ETSY_STORE_1_ACCESS_TOKEN=12345678.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ETSY_STORE_1_REFRESH_TOKEN=12345678.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ETSY_STORE_1_RATE_SOURCE=easypost
ETSY_STORE_1_EASYPOST_FROM_ADDRESS=adr_xxxxxxxx
# ETSY_STORE_2_NAME=Vintage Side Shop
# ETSY_STORE_2_SHOP_ID=87654321
# ETSY_STORE_2_API_KEY=yyyyyyyyyyyyyyyyyyyyyyyyy
# ETSY_STORE_2_ACCESS_TOKEN=87654321.yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# ETSY_STORE_2_REFRESH_TOKEN=87654321.yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# ETSY_STORE_2_RATE_SOURCE=etsy
