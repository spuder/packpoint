TINDIE_USERNAME=xxxxx
TINDIE_API_KEY=xxxxxx
EASYPOST_API_KEY=xxxxxx

# Only needed if any store below is set to SHIPPING_PROVIDER=shipstation.
# SHIPSTATION_API_KEY=xxxxxx

# Every store (Tindie, and each Stripe store below) picks its own shipping
# provider and return address - see README.md's "Shipping providers"
# section for the full picture. <prefix>_SHIPPING_PROVIDER is "easypost"
# (default, shown here) or "shipstation".
TINDIE_SHIPPING_PROVIDER=easypost

# EasyPost address ID (adr_...) that Tindie orders should ship from. Only
# needed while TINDIE_SHIPPING_PROVIDER is easypost.
TINDIE_EASYPOST_FROM_ADDRESS=adr_xxxxxxxx

# If TINDIE_SHIPPING_PROVIDER were shipstation instead, it'd use these -
# see the STRIPE_STORE_2_SHIPSTATION_* example below for the same fields.
# TINDIE_SHIPSTATION_FROM_NAME=Jane Seller
# TINDIE_SHIPSTATION_FROM_COMPANY=
# TINDIE_SHIPSTATION_FROM_PHONE=5555555555
# TINDIE_SHIPSTATION_FROM_STREET1=123 Main St
# TINDIE_SHIPSTATION_FROM_CITY=Anytown
# TINDIE_SHIPSTATION_FROM_STATE=CA
# TINDIE_SHIPSTATION_FROM_POSTAL_CODE=94103
# TINDIE_SHIPSTATION_FROM_COUNTRY=US

CUPS_HOST=192.186.0.2

# International shipping (optional). CUSTOMS_SIGNER_NAME is who certifies
# the customs form EasyPost generates - defaults to the shipping store's
# return address name if unset. CUSTOMS_CATALOG_PATH overrides where Tindie
# product customs metadata (HS code/origin country/description) is loaded
# from - defaults to config/customs_catalog.yml. See that file for format.
# CUSTOMS_SIGNER_NAME=Jane Seller
# CUSTOMS_CATALOG_PATH=config/customs_catalog.yml

# Stripe is optional. Add one NAME/SECRET_KEY trio (plus that store's own
# shipping config) per store you want to pull orders from - they all share
# one PackPoint account. The id in the middle (1, 2, main, ...) just has to
# be unique and match across every var for a given store.

# Store 1: stays on EasyPost (SHIPPING_PROVIDER defaults to easypost, so
# it's omitted here) - EASYPOST_FROM_ADDRESS is the EasyPost address ID
# (adr_...) this store's orders should ship from.
STRIPE_STORE_1_NAME=My Shop
STRIPE_STORE_1_SECRET_KEY=sk_live_xxxxxxxx
STRIPE_STORE_1_EASYPOST_FROM_ADDRESS=adr_xxxxxxxx

# Store 2: ships through ShipStation instead - e.g. Jurassic Stacks. No
# EASYPOST_FROM_ADDRESS needed since this store never talks to EasyPost;
# the return address is given inline via SHIPSTATION_FROM_* since
# ShipStation has no saved-address id the way EasyPost does.
STRIPE_STORE_2_NAME=Jurassic Stacks
STRIPE_STORE_2_SECRET_KEY=sk_live_yyyyyyyy
STRIPE_STORE_2_SHIPPING_PROVIDER=shipstation
STRIPE_STORE_2_SHIPSTATION_FROM_NAME=Jurassic Stacks
STRIPE_STORE_2_SHIPSTATION_FROM_COMPANY=Jurassic Stacks
STRIPE_STORE_2_SHIPSTATION_FROM_PHONE=5555555555
STRIPE_STORE_2_SHIPSTATION_FROM_STREET1=525 S Winchester Blvd
STRIPE_STORE_2_SHIPSTATION_FROM_CITY=San Jose
STRIPE_STORE_2_SHIPSTATION_FROM_STATE=CA
STRIPE_STORE_2_SHIPSTATION_FROM_POSTAL_CODE=95128
STRIPE_STORE_2_SHIPSTATION_FROM_COUNTRY=US
