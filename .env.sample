TINDIE_USERNAME=xxxxx
TINDIE_API_KEY=xxxxxx
EASYPOST_API_KEY=xxxxxx

# EasyPost address ID (adr_...) that Tindie orders should ship from.
TINDIE_EASYPOST_FROM_ADDRESS=adr_xxxxxxxx

CUPS_HOST=192.186.0.2

# Stripe is optional. Add one NAME/SECRET_KEY/EASYPOST_FROM_ADDRESS trio per
# store you want to pull orders from - they all share one PackPoint account.
# The id in the middle (1, 2, main, ...) just has to be unique and match
# across all three vars for a given store. EASYPOST_FROM_ADDRESS is the
# EasyPost address ID (adr_...) that store's orders should ship from.
STRIPE_STORE_1_NAME=My Shop
STRIPE_STORE_1_SECRET_KEY=sk_live_xxxxxxxx
STRIPE_STORE_1_EASYPOST_FROM_ADDRESS=adr_xxxxxxxx
STRIPE_STORE_2_NAME=Side Project
STRIPE_STORE_2_SECRET_KEY=sk_live_yyyyyyyy
STRIPE_STORE_2_EASYPOST_FROM_ADDRESS=adr_yyyyyyyy
